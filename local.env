# General app configuration
SCENARIO=default
INFRA_PROVIDER=local

# Local filesystem path that stores patient data, artifacts, and images.
# If you change this value, make sure local.yaml mounts the same directory.
LOCAL_STORAGE_PATH=/app/local_data

# LLM configuration
LLM_PROVIDER=local
LOCAL_LLM_MODEL_ID=GptOss
LOCAL_LLM_API_KEY=test
LOCAL_LLM_ENDPOINT=http://local-llm:8080/v1/chat/completions
LOCAL_LLM_AUTOGEN_BASE_URL=http://local-llm:8080

# Application routing
BACKEND_APP_HOSTNAME=http://localhost:8000

# Agents expect these JSON payloads even in local mode; populate with dummy IDs or
# reuse the values from your Azure deployment if you have one.
BOT_IDS={"Orchestrator":"orchestrator-bot-id","PatientHistory":"patient-history-bot-id","PatientStatus":"patient-status-bot-id","Radiology":"radiology-bot-id","Pathology":"pathology-bot-id","ClinicalTrials":"clinical-trials-bot-id","ReportCreation":"report-creation-bot-id","MedicalResearch":"medical-research-bot-id","magentic":"magentic-bot-id"}
HLS_MODEL_ENDPOINTS={"default":{"deployment_name":"local-model","endpoint":"http://local-llm:8765:8080"}}
