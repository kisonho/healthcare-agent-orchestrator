# Copy this file to `local.env` and replace placeholder values with the resources
# that were provisioned by `azd` (or your own equivalents).

# Absolute path to the host Azure CLI configuration directory. This is mounted
# into the container so AzureCliCredential can reuse your cached tokens.
#   Windows: C:\Users\<you>\.azure
#   macOS:   /Users/<you>/.azure
#   Linux:   /home/<you>/.azure
AZURE_CONFIG_DIR_HOST=C:\Users\me\.azure

# Azure Storage account endpoint that hosts patient collateral and artifacts.
APP_BLOB_STORAGE_ENDPOINT=https://<storage-account-name>.blob.core.windows.net

# JSON-encoded mapping of agent names to their Bot registrations.
# Example: {"Orchestrator":"00000000-0000-0000-0000-000000000000", ... }
BOT_IDS={"Orchestrator":"","PatientHistory":"","PatientStatus":"","Radiology":"","Pathology":"","ClinicalTrials":"","ReportCreation":"","MedicalResearch":"","magentic":""}

# JSON-encoded configuration for downstream model endpoints. Use the output value
# from `azd env get-values HLS_MODEL_ENDPOINTS` or craft your own mapping.
HLS_MODEL_ENDPOINTS={"orchestrator":{"deployment_name":"<model-deployment>","endpoint":"https://<resource-name>.openai.azure.com/"}}

# Optional: only required when using the GraphRAG plugin.
#GRAPH_RAG_SUBSCRIPTION_KEY=

# Control which patient data backend to use. Default storage-based access.
CLINICAL_NOTES_SOURCE=storage

# Local LLM defaults. Override the endpoint/credentials if you provide a custom server.
LOCAL_LLM_MODEL_ID=local-model
LOCAL_LLM_API_KEY=test
LOCAL_LLM_ENDPOINT=http://local-llm:8080/v1/chat/completions
LOCAL_LLM_AUTOGEN_BASE_URL=http://local-llm:8080

# (Optional) For o3-style reasoning models when running the ClinicalTrials tool.
LOCAL_LLM_REASONING_MODEL_ID=reasoning-model

# FastAPI hostname used when generating deep links back into the API.
BACKEND_APP_HOSTNAME=http://localhost:8000
